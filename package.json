{
  "name": "bicii-frame-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "env -u DATABASE_URL next dev -p 3847 -H 127.0.0.1",
    "build": "next build && node scripts/migrate.mjs",
    "start": "next start -p 3847",
    "lint": "eslint",
    "test": "vitest run",
